ах благ и принимает только благое.","اللَّهُ طَيِّبٌ لَا يَقْبَلُ إِلَّا طَيِّبًا."],["Он хороший человек.","هُوَ رَجُلٌ طَيِّبٌ."],["Мой брат заболел.","مَرِضَ أَخِي."],["Когда я заболеваю, Он исцеляет меня.","وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِ."],["Болезнь — испытание.","الْمَرَضُ ابْتِلَاءٌ."],["Он толкнул дверь.","دَفَعَ الْبَابَ."],["Я заплатил за книгу.","دَفَعْتُ ثَمَنَ الْكِتَابِ."],["Не толкай брата.","لَا تَدْفَعْ أَخَاكَ."],["Он защищает слабых.","يَدْفَعُ عَنِ الضُّعَفَاءِ."],["Не печалься, Аллах с нами.","لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا."],["Я опечалился, услышав новость.","حَزِنْتُ لَمَّا سَمِعْتُ الْخَبَرَ."],["Печаль не помогает.","الْحُزْنُ لَا يَنْفَعُ."],["Я заплатил за два экземпляра.","دَفَعْتُ ثَمَنَ نُسْخَتَيْنِ."],["Он заболел и опечалился.","مَرِضَ وَحَزِنَ."],["Мягкая парча дорогая.","الدِّيبَاجُ اللَّيِّنُ غَالٍ."],["Беспечный повторяет ошибку много раз.","الْغَافِلُ يُكَرِّرُ الْخَطَأَ مَرَّاتٍ."],["Хороший запах из кухни.","رَائِحَةٌ طَيِّبَةٌ مِنَ الْمَطْبَخِ."],["Подожди мгновение, я заплачу.","اِنْتَظِرْ هُنَيْهَةً، سَأَدْفَعُ."],["Он прочитал книгу ещё раз.","قَرَأَ الْكِتَابَ مَرَّةً أُخْرَى."]]}</script>
<script>
(function(){
  const list=document.getElementById('list'), chips=document.getElementById('chips'), count=document.getElementById('count');
  const data=JSON.parse(document.getElementById('sent-data').textContent);
  const all=[]; list.innerHTML='';
  Object.keys(data).forEach(k=>{
    const a=document.createElement('a'); a.href='#u'+k; a.textContent=k; a.dataset.k=k; chips.appendChild(a);
    const sec=document.createElement('section'); sec.id='u'+k;
    sec.innerHTML=`<div class="lh"><h2>Урок ${k}</h2><div class="row"><button class="lhide">Скрыть арабский</button><button class="lshow">Показать арабский</button></div></div><ol></ol>`;
    const ol=sec.querySelector('ol'), mine=[];
    data[k].forEach(([ru,ar],i)=>{
      const li=document.createElement('li');
      li.innerHTML=`<div class="top"><span class="n">${i+1}.</span><span class="ru"></span><button class="tg"></button></div><div class="ar" lang="ar" dir="rtl"></div><div class="ph">Перевод скрыт — нажмите, чтобы открыть</div>`;
      li.querySelector('.ru').textContent=ru; li.querySelector('.ar').textContent=ar;
      const it={ar:li.querySelector('.ar'),ph:li.querySelector('.ph'),btn:li.querySelector('.tg'),shown:true};
      it.set=v=>{it.shown=v;it.ar.hidden=!v;it.ph.hidden=v;it.btn.textContent=v?'Скрыть':'Показать';};
      it.btn.onclick=()=>{it.set(!it.shown);upd();};
      it.ph.onclick=()=>{it.set(true);upd();};
      it.set(true); all.push(it); mine.push(it); ol.appendChild(li);
    });
    sec.querySelector('.lhide').onclick=()=>{mine.forEach(i=>i.set(false));upd();};
    sec.querySelector('.lshow').onclick=()=>{mine.forEach(i=>i.set(true));upd();};
    list.appendChild(sec);
  });
  function upd(){count.textContent=`Открыто: ${all.filter(i=>i.shown).length} из ${all.length}`;}
  document.getElementById('hideAll').onclick=()=>{all.forEach(i=>i.set(false));upd();};
  document.getElementById('showAll').onclick=()=>{all.forEach(i=>i.set(true));upd();};
  upd();
  // подсветка текущего урока в панели
  const secs=[...document.querySelectorAll('section')];
  const mark=()=>{let cur=secs[0];for(const s of secs){if(s.getBoundingClientRect().top<140)cur=s;}
    chips.querySelectorAll('a').forEach(a=>{const on='u'+a.dataset.k===cur.id;a.classList.toggle('on',on);});};
  addEventListener('scroll',mark,{passive:true}); mark();
  if(location.hash){const t=document.getElementById(location.hash.slice(1)); if(t) t.scrollIntoView();}
})();
</script>
